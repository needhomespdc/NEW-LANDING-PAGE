# All of these are server-only: they are never sent to the browser.

# --- Property Hub ---
PROPERTIES_API_URL=https://your-api.example.com/properties
PROPERTIES_API_KEY=

# --- Form endpoints (each form POSTs JSON to its own URL; leave blank until ready) ---
FORM_ENDPOINT_CONTACT=
FORM_ENDPOINT_PARTNER=
FORM_ENDPOINT_DATA_DELETION=
FORM_ENDPOINT_DEACTIVATION=
FORM_ENDPOINT_WAITLIST=
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# Optional: sent to every form endpoint as "Authorization: Bearer <key>"
FORM_API_KEY=


# --- Google reCAPTCHA v3 ---
# Public site key (safe to expose in the browser)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key (server-only; never prefix this with NEXT_PUBLIC_)
RECAPTCHA_SECRET_KEY=
# Optional score threshold; Google recommends starting at 0.5
RECAPTCHA_MIN_SCORE=0.5

# --- Google reviews (Places API New) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
