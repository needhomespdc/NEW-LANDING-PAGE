# All of these are server-only: they are never sent to the browser.

# --- Property Hub ---
PROPERTIES_API_URL=https://your-api.example.com/properties
PROPERTIES_API_KEY=

# --- Form endpoints (each form POSTs JSON to its own URL; leave blank until ready) ---
FORM_ENDPOINT_CONTACT=
FORM_ENDPOINT_PARTNER=
FORM_ENDPOINT_DATA_DELETION=
FORM_ENDPOINT_DEACTIVATION=
FORM_ENDPOINT_WAITLIST=
# Optional: sent to every form endpoint as "Authorization: Bearer <key>"
FORM_API_KEY=

# --- Google reviews (Places API New) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
